+#define WEBGPU_BIND_GROUP_CACHE_MAX 8192
+
+static wgpu::BindGroup ggml_webgpu_cached_bind_group(webgpu_global_context &                   gctx,
+                                                     const webgpu_pipeline &                   pipeline,
+                                                     const std::vector<wgpu::BindGroupEntry> & entries) {
+    const WGPUComputePipeline praw = pipeline.pipeline.Get();
+    auto                      lit  = gctx->bind_group_layouts.find(praw);
+    if (lit == gctx->bind_group_layouts.end()) {
+        // keeping the pipeline referenced means its handle cannot be reused by another pipeline
+        lit = gctx->bind_group_layouts
+                  .emplace(praw, std::make_pair(pipeline.pipeline, pipeline.pipeline.GetBindGroupLayout(0)))
+                  .first;
+    }
+    const wgpu::BindGroupLayout & layout = lit->second.second;
+
+    bool        cacheable = true;
+    std::string key;
+    key.reserve(sizeof(WGPUBindGroupLayout) + entries.size() * (sizeof(WGPUBuffer) + 3 * sizeof(uint64_t)));
+    const WGPUBindGroupLayout lraw = layout.Get();
+    key.append(reinterpret_cast<const char *>(&lraw), sizeof(lraw));
+    for (const wgpu::BindGroupEntry & e : entries) {
+        if (e.sampler || e.textureView) {
+            cacheable = false;
+            break;
+        }
+        const WGPUBuffer braw = e.buffer.Get();
+        const uint64_t   v[3] = { e.binding, e.offset, e.size };
+        key.append(reinterpret_cast<const char *>(&braw), sizeof(braw));
+        key.append(reinterpret_cast<const char *>(v), sizeof(v));
+    }
+    if (cacheable) {
+        auto it = gctx->bind_group_cache.find(key);
+        if (it != gctx->bind_group_cache.end()) {
+            return it->second;
+        }
+    }
+
+    wgpu::BindGroupDescriptor bind_group_desc;
+    bind_group_desc.layout     = layout;
+    bind_group_desc.entryCount = entries.size();
+    bind_group_desc.entries    = entries.data();
+    bind_group_desc.label      = pipeline.name.c_str();
+    wgpu::BindGroup bind_group = gctx->device.CreateBindGroup(&bind_group_desc);
+    if (cacheable) {
+        if (gctx->bind_group_cache.size() >= WEBGPU_BIND_GROUP_CACHE_MAX) {
+            gctx->bind_group_cache.clear();
+        }
+        gctx->bind_group_cache.emplace(std::move(key), bind_group);
+    }
+    return bind_group;
+}
