+        if (kq_sg) {
+            std::string type_name  = ggml_get_type_traits(key.src0_type)->type_name;
+            std::string type_upper = type_name;
+            std::transform(type_upper.begin(), type_upper.end(), type_upper.begin(), ::toupper);
+            std::vector<std::string> kq_defines = {
