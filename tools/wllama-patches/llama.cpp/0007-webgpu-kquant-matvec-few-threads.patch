diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_kq_sg.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_kq_sg.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_kq_sg.wgsl
@@ -0,0 +1,192 @@
+// Mat-vec (up to 16 columns) for Q4_K / Q6_K rows against Q8_1 vectors, with packed int8 dot products
+// and subgroups. Few threads per workgroup (32 or 64): every thread walks many 256-value blocks (16
+// threads per block, 16 values each, as in mul_mat_vec_q_acc.tmpl) and the per-(column, row) subgroup
+// reduction is paid once at the end, with a single barrier. In the general template every thread covers
+// one block, so for several columns the reductions (a subgroup sum and two barriers per column) cost
+// about as much as the dot products.
+// The per-value math and its association are those of mul_mat_vec_q_acc.tmpl; only the order in which
+// the partial sums of a row are added differs.
+
+enable subgroups;
+enable f16;
+requires packed_4x8_integer_dot_product;
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src0: array<u32>;
+// Q8_1 blocks as words: d | s << 16 (f16 each), then qs[8]
+@group(0) @binding(1) var<storage, read_write> src1q: array<u32>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+// one partial sum per (column, row, subgroup); subgroups are at least 4 invocations wide
+var<workgroup> partial_sums: array<f32, NUM_COLS * OUTPUTS_PER_WG * (WG_SIZE / 4)>;
+
+#ifdef MUL_ACC_Q6_K
+// the u32 at a 2-byte-aligned position (Q6_K blocks are 210 bytes): halves of two consecutive words
+fn funnel(a: u32, b: u32, aligned: bool) -> u32 {
+    return select((a >> 16u) | (b << 16u), a, aligned);
+}
+
+// 4 values (4 low bits from ql, 2 high bits from qh) minus 32, as packed i8
+fn q6_pack(ql: u32, qh: u32, ql_shift: u32, qh_shift: u32) -> u32 {
+    let v = ((ql >> ql_shift) & 0x0F0F0F0Fu) | (((qh >> qh_shift) & 0x03030303u) << 4u);
+    return (v + (0x80u - 32u) * 0x01010101u) ^ 0x80808080u;
+}
+#endif
+
+@compute @workgroup_size(WG_SIZE)
+fn main(
+    @builtin(local_invocation_id) local_id: vec3<u32>,
+    @builtin(workgroup_id) wg_id: vec3<u32>,
+    @builtin(num_workgroups) num_wg: vec3<u32>,
+    @builtin(subgroup_id) subgroup_id: u32,
+    @builtin(subgroup_invocation_id) subgroup_invocation_id: u32,
+    @builtin(num_subgroups) num_subgroups: u32
+) {
+    let thread_id = local_id.x;
+
+    let total_batches = params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let output_groups = (params.m + OUTPUTS_PER_WG - 1u) / OUTPUTS_PER_WG;
+    let batch_idx = wg_linear / output_groups;
+    if (batch_idx >= total_batches) {
+        return;
+    }
+
+    let row_base = (wg_linear % output_groups) * OUTPUTS_PER_WG;
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let dst2_stride = params.m * params.n;
+    let dst3_stride = dst2_stride * params.bs02 * params.broadcast2;
+    let src03_idx = dst3_idx / params.broadcast3;
+    let src02_idx = dst2_idx / params.broadcast2;
+    let src0_batch_offset = params.offset_src0 + src03_idx * params.stride_03 + src02_idx * params.stride_02;
+    let dst_idx_base = params.offset_dst + dst3_idx * dst3_stride + dst2_idx * dst2_stride + row_base;
+    let src1q_idx_base = (dst3_idx * params.bs02 * params.broadcast2 + dst2_idx) * params.n * (params.k / 32u);
+
+    // this thread's 16 values of a block: values 16 * tid .. 16 * tid + 15, i.e. half (phase) of
+    // Q8_1 block tid / 2
+    let tid = thread_id % 16u;
+    let phase = tid % 2u;
+#ifdef MUL_ACC_Q4_K
+    let iq4 = tid / 4u;
+    let qs_shift = 4u * ((tid >> 1u) % 2u);
+    let sub = tid / 2u; // the 32-value sub-block (scale and min)
+    let sc_shift = 8u * (sub & 3u);
+    let sc_high = sub >= 4u;
+#endif
+#ifdef MUL_ACC_Q6_K
+    let sub = (tid % 8u) / 2u;
+    let ql_off = 64u * (tid / 8u) + 32u * (sub & 1u) + 16u * phase;
+    let qh_off = 128u + 32u * (tid / 8u) + 16u * phase;
+    let ql_shift = 4u * (sub >> 1u);
+    let qh_shift = 2u * sub;
+#endif
+    let num_blocks = params.k / 256u;
+    let q8_per_col = params.k / 32u;
+
+    var acc: array<array<f32, OUTPUTS_PER_WG>, NUM_COLS>;
+    for (var block = thread_id / 16u; block < num_blocks; block += WG_SIZE / 16u) {
+        var b_qs: array<vec4<u32>, NUM_COLS>;
+        var b_ds: array<vec2<f32>, NUM_COLS>;
+        for (var col = 0u; col < NUM_COLS; col++) {
+            let w = (src1q_idx_base + col * q8_per_col + block * 8u + tid / 2u) * 9u;
+            b_ds[col] = unpack2x16float(src1q[w]);
+            let q = w + 1u + 4u * phase;
+            b_qs[col] = vec4<u32>(src1q[q], src1q[q + 1u], src1q[q + 2u], src1q[q + 3u]);
+        }
+        for (var row = 0u; row < OUTPUTS_PER_WG; row++) {
+            let output_row = row_base + row;
+            if (output_row < params.m) {
+#ifdef MUL_ACC_Q4_K
+                let wb = (src0_batch_offset + output_row * params.stride_01 + block) * 36u; // 144-byte blocks
+                let dm = unpack2x16float(src0[wb]);
+                let s0 = (src0[wb + 1u] >> sc_shift) & 0xFFu;
+                let s1 = (src0[wb + 2u] >> sc_shift) & 0xFFu;
+                let s2 = (src0[wb + 3u] >> sc_shift) & 0xFFu;
+                let scale = f32(select(s0 & 0x3Fu, (s2 & 0x0Fu) | ((s0 & 0xC0u) >> 2u), sc_high));
+                let mn = f32(select(s1 & 0x3Fu, (s2 >> 4u) | ((s1 & 0xC0u) >> 2u), sc_high));
+                let q = wb + 4u + 8u * iq4 + 4u * phase;
+                let a0 = (src0[q] >> qs_shift) & 0x0F0F0F0Fu;
+                let a1 = (src0[q + 1u] >> qs_shift) & 0x0F0F0F0Fu;
+                let a2 = (src0[q + 2u] >> qs_shift) & 0x0F0F0F0Fu;
+                let a3 = (src0[q + 3u] >> qs_shift) & 0x0F0F0F0Fu;
+                for (var col = 0u; col < NUM_COLS; col++) {
+                    let b = b_qs[col];
+                    let row_sum = dot4I8Packed(a0, b.x) + dot4I8Packed(a1, b.y) + dot4I8Packed(a2, b.z) + dot4I8Packed(a3, b.w);
+                    // each thread covers half of the Q8_1 block, so add only half of its sum
+                    acc[col][row] += b_ds[col].x * dm.x * scale * f32(row_sum) - dm.y * mn * (b_ds[col].y / 2.0);
+                }
+#endif
+#ifdef MUL_ACC_Q6_K
+                let base = (src0_batch_offset + output_row * params.stride_01 + block) * 210u; // bytes
+                let aligned = (base & 2u) == 0u;
+                let wl = (base + ql_off) / 4u;
+                let wh = (base + qh_off) / 4u;
+                let l0 = src0[wl];
+                let l1 = src0[wl + 1u];
+                let l2 = src0[wl + 2u];
+                let l3 = src0[wl + 3u];
+                let l4 = src0[wl + 4u];
+                let h0 = src0[wh];
+                let h1 = src0[wh + 1u];
+                let h2 = src0[wh + 2u];
+                let h3 = src0[wh + 3u];
+                let h4 = src0[wh + 4u];
+                let a0 = q6_pack(funnel(l0, l1, aligned), funnel(h0, h1, aligned), ql_shift, qh_shift);
+                let a1 = q6_pack(funnel(l1, l2, aligned), funnel(h1, h2, aligned), ql_shift, qh_shift);
+                let a2 = q6_pack(funnel(l2, l3, aligned), funnel(h2, h3, aligned), ql_shift, qh_shift);
+                let a3 = q6_pack(funnel(l3, l4, aligned), funnel(h3, h4, aligned), ql_shift, qh_shift);
+                let d_pos = base + 208u;
+                let dm = unpack2x16float(src0[d_pos / 4u] >> ((d_pos & 2u) * 8u)).x;
+                let sc_pos = base + 192u + tid;
+                let sc_raw = i32((src0[sc_pos / 4u] >> ((sc_pos & 3u) * 8u)) & 0xFFu);
+                let scale = f32(select(sc_raw, sc_raw - 256, sc_raw >= 128));
+                for (var col = 0u; col < NUM_COLS; col++) {
+                    let b = b_qs[col];
+                    let row_sum = dot4I8Packed(a0, b.x) + dot4I8Packed(a1, b.y) + dot4I8Packed(a2, b.z) + dot4I8Packed(a3, b.w);
+                    acc[col][row] += b_ds[col].x * dm * scale * f32(row_sum);
+                }
+#endif
+            }
+        }
+    }
+
+    for (var col = 0u; col < NUM_COLS; col++) {
+        for (var row = 0u; row < OUTPUTS_PER_WG; row++) {
+            let subgroup_total = subgroupAdd(acc[col][row]);
+            if (subgroup_invocation_id == 0u) {
+                partial_sums[(col * OUTPUTS_PER_WG + row) * (WG_SIZE / 4u) + subgroup_id] = subgroup_total;
+            }
+        }
+    }
+    workgroupBarrier();
+    for (var i = thread_id; i < NUM_COLS * OUTPUTS_PER_WG; i += WG_SIZE) {
+        let row = i % OUTPUTS_PER_WG;
+        if (row_base + row < params.m) {
+            var total = 0.0;
+            for (var s = 0u; s < num_subgroups; s++) {
+                total += partial_sums[i * (WG_SIZE / 4u) + s];
+            }
+            dst[dst_idx_base + (i / OUTPUTS_PER_WG) * params.m + row] = total;
+        }
+    }
+}
