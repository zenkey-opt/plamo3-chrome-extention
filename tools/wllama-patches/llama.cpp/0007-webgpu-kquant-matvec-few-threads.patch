         key.wg_size     = ggml_webgpu_mul_mat_vec_wg_size(context.src0, key.use_mmvq);
 
+        // Q4_K / Q6_K with packed dot products and subgroups: mul_mat_vec_kq_sg.wgsl, whose workgroups of
+        // 32 threads walk a row 2 blocks at a time (64 threads, 4 blocks, for rows of 32 blocks or more)
+        const bool kq_sg = key.use_mmvq && context.supports_subgroups && !src_overlap &&
