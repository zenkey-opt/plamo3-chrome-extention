ggml-webgpu: use the mat-vec shaders for up to 16 columns instead of 4 (micro-batches of up to 16 tokens),
and name mat-vec pipelines by their column count so GPU profiles can tell them apart.

diff --git a/ggml/src/ggml-webgpu/ggml-webgpu-shader-lib.hpp b/ggml/src/ggml-webgpu/ggml-webgpu-shader-lib.hpp
--- a/ggml/src/ggml-webgpu/ggml-webgpu-shader-lib.hpp
+++ b/ggml/src/ggml-webgpu/ggml-webgpu-shader-lib.hpp
@@ -50,6 +50,10 @@
 
 // Matrix-vector multiplication parameters
 #define WEBGPU_MUL_MAT_VEC_WG_SIZE 256
+// Products with up to this many columns (tokens in a micro-batch) use the mat-vec shaders, which read
+// the weights once for all columns. Wider ones take the tiled mat-mat path, which is far slower for
+// small batches on GPUs without subgroup matrices. Each column is computed exactly as on its own.
+#define WEBGPU_MUL_MAT_VEC_MAX_COLS 16
 
 #define WEBGPU_MUL_MAT_VEC_FLOAT_OUTPUTS_PER_WG    4
 #define WEBGPU_MUL_MAT_VEC_LEGACY_Q_OUTPUTS_PER_WG 4
@@ -1227,7 +1231,7 @@ inline bool ggml_webgpu_can_use_mmvq(const ggml_tensor * src0,
                                      const ggml_tensor * src1,
                                      bool                supports_dot_product,
                                      const std::string & vendor) {
-    if (src1->ne[1] <= 4) {
+    if (src1->ne[1] <= WEBGPU_MUL_MAT_VEC_MAX_COLS) {
         bool supports_dp4a = vendor == "amd" || vendor == "intel" || vendor == "nvidia";
         if (supports_dp4a && supports_dot_product) {
             switch (src1->type) {
@@ -2198,6 +2202,7 @@ class ggml_webgpu_shader_lib {
             variant += "_vectorized";
         }
         defines.push_back(std::string("NUM_COLS=") + std::to_string(key.num_cols));
+        variant += "_c" + std::to_string(key.num_cols);
 
         auto processed            = preprocessor.preprocess(shader_src, defines);
         auto decisions            = std::make_shared<ggml_webgpu_mul_mat_vec_shader_decisions>();
diff --git a/ggml/src/ggml-webgpu/ggml-webgpu.cpp b/ggml/src/ggml-webgpu/ggml-webgpu.cpp
--- a/ggml/src/ggml-webgpu/ggml-webgpu.cpp
+++ b/ggml/src/ggml-webgpu/ggml-webgpu.cpp
@@ -1715,7 +1715,7 @@ static webgpu_encoded_op ggml_webgpu_mul_mat(webgpu_context & ctx,
                                              ggml_tensor *    src1,
                                              ggml_tensor *    dst) {
     // Determine if this is a mat-vec operation
-    bool use_mat_vec = (dst->ne[1] <= 4);
+    bool use_mat_vec = (dst->ne[1] <= WEBGPU_MUL_MAT_VEC_MAX_COLS);
 
     // use MMVQ path for mat-vec
     bool use_mmvq = ggml_webgpu_can_use_mmvq(src0, src1, ctx->global_ctx->capabilities.supports_dot_product,
