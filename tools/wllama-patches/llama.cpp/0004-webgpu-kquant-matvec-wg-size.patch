 };
 
+// K-quant MMVQ mat-vec: 16 threads per 256-value block, and a workgroup of WEBGPU_MUL_MAT_VEC_WG_SIZE
+// threads walks a row 16 blocks at a time. A short row (K = 2560: 10 blocks) leaves whole subgroups
+// idle in every workgroup, so give such rows a workgroup of just enough subgroups (of 32) instead.
+// Each thread still covers exactly the same blocks and the reductions see the same values (the idle
+// threads only ever added zeros), so the results are unchanged.
+inline uint32_t ggml_webgpu_mul_mat_vec_wg_size(const ggml_tensor * src0, bool use_mmvq) {
+    if (use_mmvq) {
+        switch (src0->type) {
+            case GGML_TYPE_Q2_K:
+            case GGML_TYPE_Q3_K:
+            case GGML_TYPE_Q4_K:
+            case GGML_TYPE_Q5_K:
+            case GGML_TYPE_Q6_K:
+                {
+                    const uint32_t blocks = (uint32_t) (src0->ne[0] / 256);
+                    if (blocks > 0 && blocks < WEBGPU_MUL_MAT_VEC_WG_SIZE / 16) {
+                        return 32 * ((blocks + 1) / 2);
+                    }
+                    break;
+                }
+            default:
+                break;
+        }
+    }
+    return WEBGPU_MUL_MAT_VEC_WG_SIZE;
+}
