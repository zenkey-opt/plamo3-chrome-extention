+static bool ggml_webgpu_tensor_ranges_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const size_t a_off = ggml_webgpu_tensor_offset(a);
+    const size_t b_off = ggml_webgpu_tensor_offset(b);
+    return a->buffer == b->buffer && a_off < b_off + ggml_nbytes(b) && b_off < a_off + ggml_nbytes(a);
+}
+
+static bool ggml_webgpu_tensor_same_location(const ggml_tensor * a, const ggml_tensor * b) {
+    return a->buffer == b->buffer && ggml_webgpu_tensor_offset(a) == ggml_webgpu_tensor_offset(b) &&
+           a->nb[1] == b->nb[1] && a->nb[2] == b->nb[2] && a->nb[3] == b->nb[3];
+}
+
+// RMS_NORM, MUL (weight), ADD (residual), RMS_NORM, MUL (weight): the post-norm + residual add of one
+// sub-block and the pre-norm of the next one (PLaMo 3, Gemma). The ADD result (the new residual) and
+// the last MUL are used outside, the other three only inside.
+static bool ggml_webgpu_can_fuse_norm_add_norm(webgpu_context & ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    static const enum ggml_op ops[] = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD, GGML_OP_RMS_NORM, GGML_OP_MUL };
+    const int                 outputs[] = { node_idx + 2, node_idx + 4 };
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx, 5, ops, outputs, 2)) {
+        return false;
+    }
+    ggml_tensor ** n   = cgraph->nodes + node_idx;
+    ggml_tensor *  rn1 = n[0], *mul1 = n[1], *add = n[2], *rn2 = n[3], *mul2 = n[4];
+    if (mul1->src[0] != rn1 || (add->src[0] != mul1 && add->src[1] != mul1) || rn2->src[0] != add ||
+        mul2->src[0] != rn2) {
+        return false;
+    }
+    ggml_tensor * x  = rn1->src[0];
+    ggml_tensor * w1 = mul1->src[1];
+    ggml_tensor * r  = add->src[0] == mul1 ? add->src[1] : add->src[0];
+    ggml_tensor * w2 = mul2->src[1];
+    ggml_tensor * h  = add;
+    ggml_tensor * y  = mul2;
+    for (const ggml_tensor * t : { x, w1, r, h, w2, y }) {
+        if (t->type != GGML_TYPE_F32 || t->nb[0] != sizeof(float)) {
+            return false;
+        }
+    }
+    if (!ggml_are_same_shape(x, r) || !ggml_are_same_shape(x, h) || !ggml_are_same_shape(x, y) ||
+        !ggml_are_same_shape(x, rn1) || !ggml_are_same_shape(x, rn2)) {
+        return false;
+    }
+    // per-column weights shared by every row
+    for (const ggml_tensor * w : { w1, w2 }) {
+        if (w->ne[0] != x->ne[0] || ggml_nelements(w) != x->ne[0] || !ggml_is_contiguous(w)) {
+            return false;
+        }
+    }
+    if (CEIL_DIV((uint32_t) x->ne[0], ctx->global_ctx->capabilities.limits.maxComputeInvocationsPerWorkgroup) >
+        WEBGPU_NORM_ADD_NORM_MAX_ELEMS) {
+        return false;
+    }
+    // one binding covers the activations, one the weights
+    if (x->buffer != r->buffer || x->buffer != h->buffer || x->buffer != y->buffer || w1->buffer != w2->buffer) {
+        return false;
+    }
+    // A row's workgroup reads x and r before it writes h and y. Rows run in parallel, so an output may
+    // share memory with an input or with the other output only exactly (in place), never shifted.
+    const ggml_tensor * pairs[][2] = {
+        { h, x },
+        { h, r },
+        { y, x },
+        { y, r },
+        { h, y }
+    };
+    for (const auto & p : pairs) {
+        if (ggml_webgpu_tensor_ranges_overlap(p[0], p[1]) && !ggml_webgpu_tensor_same_location(p[0], p[1])) {
+            return false;
+        }
+    }
+    if (ggml_webgpu_tensor_ranges_overlap(h, y)) {
+        return false;  // h is read after y would have been written
+    }
+    return true;
+}
