diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/norm_add_norm.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/norm_add_norm.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/norm_add_norm.wgsl
@@ -0,0 +1,135 @@
+// Fused end of a post-norm transformer sub-block plus the next pre-norm (PLaMo 3, Gemma style):
+//   h = rms_norm(x) * w1 + r      (attn/ffn post-norm and the residual add)
+//   y = rms_norm(h) * w2          (pre-norm of the next sub-block)
+// i.e. RMS_NORM, MUL, ADD, RMS_NORM, MUL in one dispatch, one workgroup per row.
+// The arithmetic mirrors rms_norm_mul.wgsl and binary.wgsl (same WG_SIZE, same reduction order),
+// and rms_norm(x) * w1 goes through memory before the add, as it does between separate kernels,
+// so the compiler cannot contract it into an fma: the results are bit-identical to the unfused ops.
+
+@group(0) @binding(0)
+var<storage, read_write> act: array<f32>;  // x, r, h, y (one range of the compute buffer)
+
+@group(0) @binding(1)
+var<storage, read_write> wts: array<f32>;  // w1, w2
+
+@group(0) @binding(2)
+var<uniform> params: Params;
+
+struct Params {
+    offset_x: u32,
+    offset_r: u32,
+    offset_h: u32,
+    offset_y: u32,
+    offset_w1: u32,
+    offset_w2: u32,
+
+    stride_x1: u32,
+    stride_x2: u32,
+    stride_x3: u32,
+    stride_r1: u32,
+    stride_r2: u32,
+    stride_r3: u32,
+    stride_h1: u32,
+    stride_h2: u32,
+    stride_h3: u32,
+    stride_y1: u32,
+    stride_y2: u32,
+    stride_y3: u32,
+
+    ne0: u32,
+    ne1: u32,
+    ne2: u32,
+    ne3: u32,
+
+    eps1: f32,
+    eps2: f32
+};
+
+var<workgroup> scratch: array<f32, WG_SIZE>;
+
+// tree reduction of rms_norm_mul.wgsl; the trailing barrier lets scratch be reused
+fn workgroup_sum(lid: u32, v: f32) -> f32 {
+    scratch[lid] = v;
+
+    workgroupBarrier();
+
+    var offset: u32 = WG_SIZE / 2;
+    while (offset > 0) {
+        if (lid < offset) {
+            scratch[lid] += scratch[lid + offset];
+        }
+        offset = offset / 2;
+        workgroupBarrier();
+    }
+    let total = scratch[0];
+    workgroupBarrier();
+    return total;
+}
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) wid: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>,
+        @builtin(local_invocation_id) lid: vec3<u32>) {
+
+    // one workgroup per row
+    var i = wid.x + wid.y * num_wg.x;
+    if (i >= params.ne1 * params.ne2 * params.ne3) {
+        return;
+    }
+    let i3 = i / (params.ne2 * params.ne1);
+    i = i % (params.ne2 * params.ne1);
+    let i2 = i / params.ne1;
+    let i1 = i % params.ne1;
+    let x_row = params.offset_x + i3 * params.stride_x3 + i2 * params.stride_x2 + i1 * params.stride_x1;
+    let r_row = params.offset_r + i3 * params.stride_r3 + i2 * params.stride_r2 + i1 * params.stride_r1;
+    let h_row = params.offset_h + i3 * params.stride_h3 + i2 * params.stride_h2 + i1 * params.stride_h1;
+    let y_row = params.offset_y + i3 * params.stride_y3 + i2 * params.stride_y2 + i1 * params.stride_y1;
+
+    let elems = (params.ne0 + WG_SIZE - 1) / WG_SIZE;
+
+    // rms_norm(x)
+    var sum = 0.0f;
+    var col = lid.x;
+    for (var j: u32 = 0; j < elems; j++) {
+        if (col >= params.ne0) {
+            break;
+        }
+        sum += pow(act[x_row + col], 2.0);
+        col += WG_SIZE;
+    }
+    sum = workgroup_sum(lid.x, sum);
+    let scale1 = 1.0/sqrt(sum/f32(params.ne0) + params.eps1);
+
+    // h = rms_norm(x) * w1, then + r. Every row is handled by one workgroup and every element by one
+    // thread, so reading r before writing h also covers h stored in place of r (or of x).
+    var r_vals: array<f32, MAX_ELEMS>;
+    for (var j: u32 = 0; j < MAX_ELEMS; j++) {
+        let c = lid.x + j * WG_SIZE;
+        if (c < params.ne0) {
+            r_vals[j] = act[r_row + c];
+            act[h_row + c] = scale1 * act[x_row + c] * wts[params.offset_w1 + c];
+        }
+    }
+    storageBarrier();
+    var h_vals: array<f32, MAX_ELEMS>;
+    var sum2 = 0.0f;
+    for (var j: u32 = 0; j < MAX_ELEMS; j++) {
+        let c = lid.x + j * WG_SIZE;
+        if (c < params.ne0) {
+            let h = act[h_row + c] + r_vals[j];
+            act[h_row + c] = h;
+            h_vals[j] = h;
+            sum2 += pow(h, 2.0);
+        }
+    }
+
+    // y = rms_norm(h) * w2 (y may reuse the memory of x or r: all of their reads are done)
+    sum2 = workgroup_sum(lid.x, sum2);
+    let scale2 = 1.0/sqrt(sum2/f32(params.ne0) + params.eps2);
+    for (var j: u32 = 0; j < MAX_ELEMS; j++) {
+        let c = lid.x + j * WG_SIZE;
+        if (c < params.ne0) {
+            act[y_row + c] = scale2 * h_vals[j] * wts[params.offset_w2 + c];
+        }
+    }
+}
