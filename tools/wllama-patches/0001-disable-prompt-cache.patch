diff --git a/cpp/wllama-context.h b/cpp/wllama-context.h
index 17303e2..b8447b2 100644
--- a/cpp/wllama-context.h
+++ b/cpp/wllama-context.h
@@ -601,6 +601,12 @@ struct wllama_context
     // init threadpool
     ggml_threadpool_params_default(params.cpuparams.n_threads);
 
+    // [plamo3-translate-local] disable the host-RAM prompt cache. Under WebGPU every slot save is a chain of
+    // GPU readbacks (~11 s per batch with a unified KV, measured) and the cache keeps growing up to
+    // 8 GiB of wasm memory. Translation requests never repeat a prompt, so it only costs.
+    params.cache_ram_mib = 0;
+    params.cache_idle_slots = false;
+
     // load model
     llama_backend_init();
     llama_numa_init(params.numa);
