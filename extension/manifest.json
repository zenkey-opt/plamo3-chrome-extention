{
  "manifest_version": 3,
  "name": "PLaMo 3 Translate Local",
  "short_name": "PLaMo3 翻訳",
  "version": "0.2.5",
  "description": "PLaMo 3 Translate をブラウザの中で動かして、選択テキスト・ページ・入力文を翻訳する非公式の拡張機能です。原文を外部に送りません。Built with PLaMo",
  "key": "",
  "minimum_chrome_version": "137",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.huggingface.co/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PLaMo 3 Translate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "選択テキストを翻訳"
    },
    "translate-page": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "ページを翻訳 / 原文に戻す"
    }
  }
}
